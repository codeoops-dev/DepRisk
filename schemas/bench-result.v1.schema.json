{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codeoops-dev/deprisk/schemas/bench-result.v1.schema.json",
  "title": "DepRisk benchmark result (v1)",
  "description": "Output of 'deprisk bench --format json': the baselines and the risk model compared on labeled cases, reachability against ground truth, and calibration. Deterministic: no timestamps, no absolute paths. A result is evidence only if its dataset is: a dataset with synthetic=true is a test fixture. Numbers are rounded to six decimals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tool",
    "dataset",
    "split",
    "model",
    "counts",
    "methods",
    "differences",
    "bootstrap",
    "reach",
    "reachByLabel",
    "calibration",
    "notEvaluated",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "synthetic",
        "digest",
        "signalsAsOf",
        "outcomeFrom",
        "outcomeTo",
        "labelSource"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "synthetic": {
          "type": "boolean"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signalsAsOf": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "outcomeFrom": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "outcomeTo": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "labelSource": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "digest is the SHA-256 of the manifest file. signalsAsOf is the date the EPSS and KEV data were fixed at; outcomes are observed from outcomeFrom to outcomeTo."
    },
    "split": {
      "enum": [
        "dev",
        "test",
        "all"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samples",
        "seed",
        "seedSource",
        "rankBy",
        "calibration",
        "parametersDigest"
      ],
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "seedSource": {
          "type": "string",
          "minLength": 1
        },
        "rankBy": {
          "enum": [
            "mean",
            "p50",
            "p90",
            "p95",
            "cvar95"
          ]
        },
        "calibration": {
          "type": "string",
          "minLength": 1
        },
        "parametersDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "casesWithPositives",
        "findings",
        "labeled",
        "unlabeled",
        "labelsUnmatched",
        "exploited",
        "reachTruthKnown",
        "reachableTruth"
      ],
      "properties": {
        "cases": {
          "type": "integer",
          "minimum": 0
        },
        "casesWithPositives": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "labeled": {
          "type": "integer",
          "minimum": 0
        },
        "unlabeled": {
          "type": "integer",
          "minimum": 0
        },
        "labelsUnmatched": {
          "type": "integer",
          "minimum": 0
        },
        "exploited": {
          "type": "integer",
          "minimum": 0
        },
        "reachTruthKnown": {
          "type": "integer",
          "minimum": 0
        },
        "reachableTruth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "casesWithPositives",
          "casesFullRecall",
          "presented",
          "suppressed",
          "exploitedMissed",
          "averagePrecision",
          "alertFractionToFullRecall",
          "atK",
          "averagePrecisionCi",
          "alertFractionCi"
        ],
        "properties": {
          "id": {
            "enum": [
              "b1-cvss",
              "b2-baseline",
              "b3-reachable-only",
              "b3c-not-unreachable",
              "deprisk-risk"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "casesWithPositives": {
            "type": "integer",
            "minimum": 0
          },
          "casesFullRecall": {
            "type": "integer",
            "minimum": 0
          },
          "presented": {
            "type": "integer",
            "minimum": 0
          },
          "suppressed": {
            "type": "integer",
            "minimum": 0
          },
          "exploitedMissed": {
            "type": "integer",
            "minimum": 0
          },
          "averagePrecision": {
            "type": [
              "number",
              "null"
            ]
          },
          "alertFractionToFullRecall": {
            "type": [
              "number",
              "null"
            ]
          },
          "atK": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "k",
                "recall",
                "precision"
              ],
              "properties": {
                "k": {
                  "type": "integer",
                  "minimum": 1
                },
                "recall": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "precision": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "averagePrecisionCi": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "low",
                  "high"
                ],
                "properties": {
                  "low": {
                    "type": "number"
                  },
                  "high": {
                    "type": "number"
                  }
                }
              }
            ]
          },
          "alertFractionCi": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "low",
                  "high"
                ],
                "properties": {
                  "low": {
                    "type": "number"
                  },
                  "high": {
                    "type": "number"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "differences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "versus",
          "metric",
          "difference",
          "ci"
        ],
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "versus": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "enum": [
              "averagePrecision",
              "alertFractionToFullRecall"
            ]
          },
          "difference": {
            "type": [
              "number",
              "null"
            ]
          },
          "ci": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "low",
                  "high"
                ],
                "properties": {
                  "low": {
                    "type": "number"
                  },
                  "high": {
                    "type": "number"
                  }
                }
              }
            ]
          }
        }
      },
      "description": "method minus versus, with a paired bootstrap interval."
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iterations",
        "seed",
        "level",
        "notComputedReason"
      ],
      "properties": {
        "iterations": {
          "type": "integer",
          "minimum": 0
        },
        "seed": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "level": {
          "type": "number"
        },
        "notComputedReason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reach": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evaluated",
            "coverage",
            "unreachableTotal",
            "unsoundUnreachable",
            "rows",
            "strict",
            "lenient"
          ],
          "properties": {
            "evaluated": {
              "type": "integer",
              "minimum": 0
            },
            "coverage": {
              "type": [
                "number",
                "null"
              ]
            },
            "unreachableTotal": {
              "type": "integer",
              "minimum": 0
            },
            "unsoundUnreachable": {
              "type": "integer",
              "minimum": 0
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "truthReachable",
                  "truthNotReachable"
                ],
                "properties": {
                  "label": {
                    "enum": [
                      "reachable",
                      "possibly-reachable",
                      "unreachable",
                      "unknown"
                    ]
                  },
                  "truthReachable": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "truthNotReachable": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "strict": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "predicted",
                "truePositives",
                "truthPositives",
                "precision",
                "recall"
              ],
              "properties": {
                "predicted": {
                  "type": "integer",
                  "minimum": 0
                },
                "truePositives": {
                  "type": "integer",
                  "minimum": 0
                },
                "truthPositives": {
                  "type": "integer",
                  "minimum": 0
                },
                "precision": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "recall": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            },
            "lenient": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "predicted",
                "truePositives",
                "truthPositives",
                "precision",
                "recall"
              ],
              "properties": {
                "predicted": {
                  "type": "integer",
                  "minimum": 0
                },
                "truePositives": {
                  "type": "integer",
                  "minimum": 0
                },
                "truthPositives": {
                  "type": "integer",
                  "minimum": 0
                },
                "precision": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "recall": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            }
          },
          "description": "unsoundUnreachable: findings called unreachable that are truly reachable."
        }
      ]
    },
    "reachByLabel": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "count",
          "observedReachableRate",
          "meanPredictedReach"
        ],
        "properties": {
          "label": {
            "enum": [
              "reachable",
              "possibly-reachable",
              "unreachable",
              "unknown",
              "not-analyzed"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "observedReachableRate": {
            "type": [
              "number",
              "null"
            ]
          },
          "meanPredictedReach": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "calibration": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quantity",
          "predicted",
          "outcome",
          "summary"
        ],
        "properties": {
          "quantity": {
            "enum": [
              "exploit-model",
              "epss-raw",
              "reach-model"
            ]
          },
          "predicted": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "count",
              "baseRate",
              "brier",
              "logLoss",
              "ece",
              "bins"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "baseRate": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "brier": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "logLoss": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "ece": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "bins": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "low",
                    "high",
                    "count",
                    "meanPredicted",
                    "observedRate"
                  ],
                  "properties": {
                    "low": {
                      "type": "number"
                    },
                    "high": {
                      "type": "number"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "meanPredicted": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "observedRate": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "notEvaluated": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "reason"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
