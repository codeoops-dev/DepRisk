{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codeoops-dev/deprisk/schemas/reachability.v1.schema.json",
  "title": "DepRisk reachability (v1)",
  "description": "Output of 'deprisk reach --format json': for every advisory that applies, whether the vulnerable code can be reached from the application, with the evidence. Deterministic: no timestamps, no absolute paths. Labels describe a conservative call graph built from source, not exploitability (ADR 0012, ADR 0013). Text fields that come from advisories or from the analyzer are untrusted data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tool",
    "ecosystem",
    "advisories",
    "symbolMaps",
    "analyzer",
    "source",
    "summary",
    "findings",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ecosystem": {
      "enum": [
        "nuget",
        "npm"
      ]
    },
    "advisories": {
      "description": "The advisory data the result was computed from.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "digest",
        "count",
        "skippedWithdrawn",
        "skippedOtherEcosystem",
        "skippedInvalid"
      ],
      "properties": {
        "source": {
          "description": "File or directory name only, never a full path.",
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "description": "SHA-256 of the advisory source (the file's bytes for a .zip or .json; a digest of per-file digests for a directory), lowercase hex.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "count": {
          "description": "Advisories with at least one entry for the scanned ecosystem that were used.",
          "type": "integer",
          "minimum": 0
        },
        "skippedWithdrawn": {
          "type": "integer",
          "minimum": 0
        },
        "skippedOtherEcosystem": {
          "description": "Valid records that have no entry for the scanned ecosystem (other ecosystems, or vendor ecosystems such as 'Echo:NuGet').",
          "type": "integer",
          "minimum": 0
        },
        "skippedInvalid": {
          "description": "Records that could not be read. Greater than zero means vulnerabilities may be missing.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "symbolMaps": {
      "description": "The symbol lists the verdicts were computed with.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "digest",
        "files",
        "entries"
      ],
      "properties": {
        "source": {
          "description": "File or directory name only, never a full path.",
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "description": "SHA-256 over the digests of the symbol map files.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "entries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "analyzer": {
      "description": "Null when no analysis ran: nothing had a symbol list, or the ecosystem has no analyzer.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 of the analyzer executable.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source": {
      "description": "What the analyzer read. Null when no analysis ran.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "sourceDigest",
        "files",
        "filesSkipped",
        "filesWithErrors",
        "methods",
        "edges",
        "entrypoints"
      ],
      "properties": {
        "sourceDigest": {
          "description": "SHA-256 over '<sha256 of file>  <relative path>' lines of every source file that was read.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "filesSkipped": {
          "type": "integer",
          "minimum": 0
        },
        "filesWithErrors": {
          "type": "integer",
          "minimum": 0
        },
        "methods": {
          "type": "integer",
          "minimum": 0
        },
        "edges": {
          "type": "integer",
          "minimum": 0
        },
        "entrypoints": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reachable",
        "possiblyReachable",
        "unreachable",
        "unknown"
      ],
      "properties": {
        "reachable": {
          "type": "integer",
          "minimum": 0
        },
        "possiblyReachable": {
          "type": "integer",
          "minimum": 0
        },
        "unreachable": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "description": "Most urgent first: reachable, possibly-reachable, unknown, unreachable; within a label in the order of 'deprisk match'.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding",
          "reachability"
        ],
        "properties": {
          "finding": {
            "$ref": "#/$defs/finding"
          },
          "reachability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "reason",
              "symbol",
              "path",
              "symbolSources"
            ],
            "properties": {
              "label": {
                "enum": [
                  "reachable",
                  "possibly-reachable",
                  "unreachable",
                  "unknown"
                ]
              },
              "reason": {
                "enum": [
                  "static-path",
                  "dynamic-path",
                  "no-path",
                  "no-symbols",
                  "no-entrypoints",
                  "symbol-list-incomplete",
                  "incomplete-analysis",
                  "unresolved-reflection",
                  "unresolved-receiver",
                  "transitive-package-code-not-analyzed",
                  "no-analyzer-for-ecosystem"
                ]
              },
              "symbol": {
                "description": "The symbol that was reached; null when there is no path.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "path": {
                "description": "The shortest path from an entrypoint to the symbol (at most 100 edges): static edges only for 'reachable'.",
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "from",
                    "to",
                    "kind",
                    "file",
                    "line"
                  ],
                  "properties": {
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "static",
                        "dynamic"
                      ]
                    },
                    "file": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "line": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  }
                }
              },
              "symbolSources": {
                "description": "Where the symbol list comes from (provenance from the symbol map).",
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "diagnostics": {
      "description": "Notes from the analysis (at most about 20), for example files that could not be read completely.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "aliases",
        "summary",
        "severity",
        "scores",
        "package",
        "fixedVersions",
        "locations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "description": "The database's own rating (for example GitHub's CRITICAL, HIGH, MODERATE, LOW), if present.",
          "type": [
            "string",
            "null"
          ]
        },
        "scores": {
          "description": "Published severity scores, for example a CVSS vector. Not interpreted by 'match'.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "score"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "score": {
                "type": "string"
              }
            }
          }
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "description": "Normalized version of the installed package (NuGet: three numeric parts, four if the revision is not zero; npm: SemVer without build metadata).",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "fixedVersions": {
          "description": "Versions above the installed one that the advisory lists as fixed, ascending. The first is the smallest known upgrade. Empty if no fix is known.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "project",
              "target",
              "isDirect"
            ],
            "properties": {
              "project": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "isDirect": {
                "type": "boolean"
              },
              "projectFile": {
                "description": "The file that stands for the project in the repository: the project file when known, otherwise the assets file path. Relative, forward slashes.",
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
