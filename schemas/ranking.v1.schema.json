{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codeoops-dev/deprisk/schemas/ranking.v1.schema.json",
  "title": "DepRisk ranking (v1)",
  "description": "Output of 'deprisk rank --format json': findings (see findings.v1) ordered by the baseline method, with the exploitation and severity signals used. Deterministic: no timestamps, no absolute paths. Dates inside 'signals' are the ones published in the EPSS and KEV data, never the current time. Text fields come from third-party data and are untrusted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tool",
    "ecosystem",
    "method",
    "ordering",
    "advisories",
    "signals",
    "projectsScanned",
    "packagesScanned",
    "packagesSkipped",
    "findings",
    "reach"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ecosystem": {
      "enum": [
        "nuget",
        "npm"
      ]
    },
    "method": {
      "description": "The ranking method. 'baseline-kev-epss-cvss' is the reference (B2) the later model is evaluated against.",
      "enum": [
        "baseline-kev-epss-cvss"
      ]
    },
    "ordering": {
      "description": "The sort keys in priority order. Each key only orders findings that are equal on the keys before it. Missing data sorts last on its key.",
      "type": "array",
      "items": {
        "enum": [
          "kev",
          "epss",
          "cvss",
          "severity",
          "id"
        ]
      },
      "minItems": 1
    },
    "advisories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "digest",
        "count",
        "skippedWithdrawn",
        "skippedOtherEcosystem",
        "skippedInvalid"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "skippedWithdrawn": {
          "type": "integer",
          "minimum": 0
        },
        "skippedOtherEcosystem": {
          "type": "integer",
          "minimum": 0
        },
        "skippedInvalid": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epss",
        "kev"
      ],
      "properties": {
        "epss": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/signalSource"
            }
          ]
        },
        "kev": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/signalSource"
            }
          ]
        }
      }
    },
    "projectsScanned": {
      "type": "integer",
      "minimum": 0
    },
    "packagesScanned": {
      "type": "integer",
      "minimum": 0
    },
    "packagesSkipped": {
      "type": "integer",
      "minimum": 0
    },
    "findings": {
      "description": "Most urgent first. Ranks are 1..N without ties.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/rankedFinding"
      }
    },
    "reach": {
      "description": "How the reachability verdicts were made. Null when no symbol maps were supplied.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "analyzer",
        "symbolMaps",
        "source",
        "summary"
      ],
      "properties": {
        "analyzer": {
          "description": "Null when no analysis ran: nothing had a symbol list, or the ecosystem has no analyzer.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "sha256"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "sha256": {
              "description": "SHA-256 of the analyzer executable.",
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "symbolMaps": {
          "description": "The symbol lists the verdicts were computed with.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "digest",
            "files",
            "entries"
          ],
          "properties": {
            "source": {
              "description": "File or directory name only, never a full path.",
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "description": "SHA-256 over the digests of the symbol map files.",
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "files": {
              "type": "integer",
              "minimum": 0
            },
            "entries": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "source": {
          "description": "What the analyzer read. Null when no analysis ran.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "sourceDigest",
            "files",
            "filesSkipped",
            "filesWithErrors",
            "methods",
            "edges",
            "entrypoints"
          ],
          "properties": {
            "sourceDigest": {
              "description": "SHA-256 over '<sha256 of file>  <relative path>' lines of every source file that was read.",
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "files": {
              "type": "integer",
              "minimum": 0
            },
            "filesSkipped": {
              "type": "integer",
              "minimum": 0
            },
            "filesWithErrors": {
              "type": "integer",
              "minimum": 0
            },
            "methods": {
              "type": "integer",
              "minimum": 0
            },
            "edges": {
              "type": "integer",
              "minimum": 0
            },
            "entrypoints": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reachable",
            "possiblyReachable",
            "unreachable",
            "unknown"
          ],
          "properties": {
            "reachable": {
              "type": "integer",
              "minimum": 0
            },
            "possiblyReachable": {
              "type": "integer",
              "minimum": 0
            },
            "unreachable": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "$defs": {
    "signalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "digest",
        "version",
        "date",
        "entries",
        "skipped"
      ],
      "properties": {
        "source": {
          "description": "File name only.",
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "description": "SHA-256 of the supplied file's bytes.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "version": {
          "description": "EPSS model version or KEV catalog version, as published in the data.",
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "description": "EPSS score date or KEV release date, as published in the data.",
          "type": [
            "string",
            "null"
          ]
        },
        "entries": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "description": "Malformed rows or entries that were ignored.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rankedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "id",
        "aliases",
        "summary",
        "severity",
        "package",
        "fixedVersions",
        "locations",
        "signals",
        "reachability"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "description": "The advisory database's own rating, if present.",
          "type": [
            "string",
            "null"
          ]
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "fixedVersions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "project",
              "target",
              "isDirect"
            ],
            "properties": {
              "project": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "isDirect": {
                "type": "boolean"
              },
              "projectFile": {
                "description": "The file that stands for the project in the repository: the project file when known, otherwise the assets file path. Relative, forward slashes.",
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "signals": {
          "description": "null means the signal is not available for this finding, never zero.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cvss",
            "epss",
            "kev"
          ],
          "properties": {
            "cvss": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "version",
                    "vector",
                    "baseScore",
                    "rating"
                  ],
                  "properties": {
                    "version": {
                      "enum": [
                        "3.0",
                        "3.1"
                      ]
                    },
                    "vector": {
                      "type": "string",
                      "pattern": "^CVSS:3\\.[01]/"
                    },
                    "baseScore": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10
                    },
                    "rating": {
                      "enum": [
                        "NONE",
                        "LOW",
                        "MEDIUM",
                        "HIGH",
                        "CRITICAL"
                      ]
                    }
                  }
                }
              ]
            },
            "epss": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cve",
                    "probability",
                    "percentile"
                  ],
                  "properties": {
                    "cve": {
                      "type": "string",
                      "pattern": "^CVE-\\d{4}-\\d{4,}$"
                    },
                    "probability": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "percentile": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              ]
            },
            "kev": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cve",
                    "dateAdded",
                    "knownRansomwareUse"
                  ],
                  "properties": {
                    "cve": {
                      "type": "string",
                      "pattern": "^CVE-\\d{4}-\\d{4,}$"
                    },
                    "dateAdded": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "knownRansomwareUse": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            }
          }
        },
        "reachability": {
          "description": "The reachability verdict (see 'deprisk reach' for the path). Null when no symbol maps were supplied: not analyzed, never 'unreachable'. Does not affect rank.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "label",
            "reason",
            "symbol"
          ],
          "properties": {
            "label": {
              "enum": [
                "reachable",
                "possibly-reachable",
                "unreachable",
                "unknown"
              ]
            },
            "reason": {
              "enum": [
                "static-path",
                "dynamic-path",
                "no-path",
                "no-symbols",
                "no-entrypoints",
                "symbol-list-incomplete",
                "incomplete-analysis",
                "unresolved-reflection",
                "unresolved-receiver",
                "transitive-package-code-not-analyzed",
                "no-analyzer-for-ecosystem"
              ]
            },
            "symbol": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
