<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>deprisk</AssemblyName>
    <RootNamespace>DepRisk.Cli</RootNamespace>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>deprisk</ToolCommandName>
    <PackageId>DepRisk.Cli</PackageId>
    <Description>Reachability-aware, uncertainty-driven dependency vulnerability triage and verified remediation planning, from your terminal.</Description>
    <PackageTags>dependency-security;vulnerability-management;sbom;supply-chain-security;reachability-analysis;cli</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/codeoops-dev/deprisk</PackageProjectUrl>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DepRisk.Core\DepRisk.Core.csproj" />
    <ProjectReference Include="..\DepRisk.Data\DepRisk.Data.csproj" />
    <ProjectReference Include="..\DepRisk.Audit\DepRisk.Audit.csproj" />
  </ItemGroup>

  <!--
    The reachability analyzer (analyzers/reach, Rust) is bundled per platform: the release workflow builds it on a runner of each platform
    and stages it as analyzers/<rid>/deprisk-reach[.exe] here (ADR 0022). BundleAnalyzers=true puts the staged files into the package
    next to the tool, where AnalyzerLocator looks for them; by default (a plain build or pack) nothing is bundled.
  -->
  <PropertyGroup>
    <BundledAnalyzerPlatforms>linux-x64;linux-arm64;osx-x64;osx-arm64;win-x64</BundledAnalyzerPlatforms>
  </PropertyGroup>

  <ItemGroup Condition="'$(BundleAnalyzers)' == 'true'">
    <None Include="analyzers/**" Pack="true" PackagePath="tools/$(TargetFramework)/any/analyzers/" />
  </ItemGroup>

  <Target Name="CheckBundledAnalyzers" BeforeTargets="GenerateNuspec;_GetPackageFiles" Condition="'$(BundleAnalyzers)' == 'true' And '$(AllowMissingAnalyzers)' != 'true'">
    <ItemGroup>
      <_Platform Include="$(BundledAnalyzerPlatforms)" />
      <_MissingAnalyzer Include="@(_Platform)" Condition="!Exists('$(MSBuildProjectDirectory)/analyzers/%(Identity)/deprisk-reach') And !Exists('$(MSBuildProjectDirectory)/analyzers/%(Identity)/deprisk-reach.exe')" />
    </ItemGroup>
    <Error Condition="'@(_MissingAnalyzer)' != ''" Text="BundleAnalyzers=true but no analyzer is staged in src/DepRisk.Cli/analyzers for: @(_MissingAnalyzer). Build them with .github/workflows/analyzer-build.yml, or pass -p:AllowMissingAnalyzers=true for a partial package." />
  </Target>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="DepRisk.Cli.Tests" />
  </ItemGroup>

</Project>
